{
  "family": "sipsugy-frontend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::068765434624:role/sipsugyEcsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::068765434624:role/sipsugyEcsTaskRole",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "068765434624.dkr.ecr.ap-south-1.amazonaws.com/sipsugy-frontend:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 80, "hostPort": 80, "protocol": "tcp" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "ecs/sipsugy-frontend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ]
}