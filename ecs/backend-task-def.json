{
  "family": "sipsugy-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::068765434624:role/sipsugyEcsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "068765434624.dkr.ecr.ap-south-1.amazonaws.com/sipsugy-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "4000" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "FRONTEND_ORIGIN", "value": "*" },
        { "name": "DB_HOST", "value": "sipsugy-db.cr2i8o6uod9u.ap-south-1.rds.amazonaws.com" },
        { "name": "DB_PORT", "value": "3306" },
        { "name": "DB_USER", "value": "admin" },
        { "name": "DB_NAME", "value": "sipsugy" }
      ],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "/sipsugy/db/password"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:4000/api/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/sipsugy-backend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "backend"
        }
      }
    }
  ]
}
